        <div class="bg-slate-900 border border-slate-700 w-full max-w-lg rounded-2xl p-6 shadow-2xl">
            <div class="flex justify-between items-center mb-4">
                <h3 class="font-bold text-amber-400 text-lg flex items-center gap-2">
                    <i class="fa-solid fa-shield-halved"></i> AARV ओनर एडमिन पैनल
                </h3>
                <button onclick="closeAdminModal()" class="text-gray-400 hover:text-white text-xl">&times;</button>
            </div>

            <div id="adminAuthScreen">
                <label class="block text-xs text-gray-300 mb-2">मालिक सुरक्षा पिन दर्ज करें (डिफ़ॉल्ट पिन: 1234)</label>
                <input type="password" id="adminPin" placeholder="Enter PIN" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2.5 text-sm text-white mb-4">
                <button onclick="verifyPin()" class="w-full gold-gradient text-black font-bold py-2 rounded-lg text-sm">लॉगिन करें</button>
            </div>

            <div id="adminDashboardScreen" class="hidden space-y-4">
                <div class="border-b border-slate-800 pb-3">
                    <h4 class="text-xs font-bold text-gray-400 uppercase mb-2">1. आज के थोक भाव अपडेट करें</h4>
                    <div class="grid grid-cols-2 gap-2 max-h-40 overflow-y-auto" id="adminRateInputs"></div>
                    <button onclick="saveNewRates()" class="mt-3 bg-amber-500 hover:bg-amber-400 text-black text-xs font-bold py-1.5 px-3 rounded">नए भाव लाइव करें</button>
                </div>

                <div>
                    <h4 class="text-xs font-bold text-gray-400 uppercase mb-2">2. मार्केटिंग वॉल पर लाइव फोटो डालें</h4>
                    <input type="text" id="postTitle" placeholder="टाइटल (उदा. 22 टायरी ट्रेलर 45 टन लोड रवाना)" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-xs text-white mb-2">
                    <input type="text" id="postImgUrl" placeholder="फोटो URL लिंक" class="w-full bg-slate-800 border border-slate-700 rounded-lg p-2 text-xs text-white mb-2">
                    <button onclick="publishNewPost()" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold py-2 rounded-lg">मार्केटिंग वॉल पर पब्लिश करें</button>
                </div>
            </div>
        </div>
    </div>

    <!-- जावास्क्रिप्ट इंजन -->
    <script>
        let materials = [
            { id: 1, name: "6 mm गिट्टी", rate: 390, icon: "fa-cube" },
            { id: 2, name: "10 mm गिट्टी", rate: 410, icon: "fa-cubes" },
            { id: 3, name: "20 mm गिट्टी (RCC)", rate: 430, icon: "fa-layer-group" },
            { id: 4, name: "40 mm गिट्टी", rate: 370, icon: "fa-shapes" },
            { id: 5, name: "53 mm रोड मेटल", rate: 360, icon: "fa-road" },
            { id: 6, name: "65 mm मेटल", rate: 350, icon: "fa-mound" },
            { id: 7, name: "90 mm सोलिंग स्टोन", rate: 340, icon: "fa-gem" },
            { id: 8, name: "GSB ग्रेनुलर सब-बेस", rate: 290, icon: "fa-align-justify" },
            { id: 9, name: "चक्की डस्ट (खनक)", rate: 240, icon: "fa-wind" },
            { id: 10, name: "M-Sand (मशीन सैंड)", rate: 460, icon: "fa-mountain" },
            { id: 11, name: "रिवर सैंड (रेत)", rate: 680, icon: "fa-water" }
        ];

        let marketingPosts = [
            {
                title: "खनक माइंस से 22 टायरी ट्रेलर द्वारा 48 टन 20mm गिट्टी का बल्क लोड रवाना",
                tag: "बल्क डिस्पैच",
                time: "आज सुबह 09:15 बजे",
                img: "https://images.unsplash.com/photo-1578575437130-527eed3abbec?auto=format&fit=crop&w=600&q=80"
            },
            {
                title: "खनक क्रशर प्लांट पर 10mm व GSB का 6,000 टन फ्रेश स्टॉक NHAI टेंडर हेतु तैयार",
                tag: "खनक प्लांट स्टॉक",
                time: "कल दोपहर",
                img: "https://images.unsplash.com/photo-1581094288338-2314dddb7ece?auto=format&fit=crop&w=600&q=80"
            },
            {
                title: "22 टायरी ट्रेलर्स का फ्लीट तोशाम हाईवे साइट पर अनलोडिंग करते हुए",
                tag: "लाइव डिलीवरी",
                time: "2 दिन पहले",
                img: "https://images.unsplash.com/photo-1601584115197-04ecc0da31d7?auto=format&fit=crop&w=600&q=80"
            }
        ];

        function renderRates() {
            document.getElementById('rateTicker').innerHTML = materials.map(m => `<span>${m.name}: <strong class="text-black">₹${m.rate}/टन</strong></span>`).join(' • ');

            document.getElementById('calcMaterial').innerHTML = materials.map(m => `<option value="${m.rate}" data-name="${m.name}">${m.name} (₹${m.rate}/टन)</option>`).join('');

            document.getElementById('materialCatalogGrid').innerHTML = materials.map(m => `
                <div class="bg-slate-800/60 p-3.5 rounded-xl border border-slate-700/60 flex flex-col justify-between">
                    <div>
                        <i class="fa-solid ${m.icon} text-amber-400 text-lg mb-1"></i>
                        <h4 class="font-bold text-xs text-white">${m.name}</h4>
                    </div>
                    <div class="mt-2 pt-2 border-t border-slate-700 flex justify-between items-center">
                        <span class="text-xs text-amber-400 font-black">₹${m.rate}/टन</span>
                        <span class="text-[9px] text-amber-400 bg-amber-500/10 px-1.5 py-0.5 rounded">न्यूनतम 40T</span>
                    </div>
                </div>
            `).join('');

            calculate();
        }

        function renderFeed() {
            document.getElementById('marketingFeedGrid').innerHTML = marketingPosts.map(p => `
                <div class="bg-slate-900 rounded-xl overflow-hidden border border-slate-800 shadow-lg group hover:border-amber-500/50 transition">
                    <img src="${p.img}" class="w-full h-44 object-cover group-hover:scale-105 transition duration-500" alt="Work Photo">
                    <div class="p-4">
                        <div class="flex justify-between items-center text-[10px] text-gray-400 mb-1">
                            <span class="bg-amber-500/10 text-amber-400 px-2 py-0.5 rounded font-bold">${p.tag}</span>
                            <span>${p.time}</span>
                        </div>
                        <h4 class="font-bold text-xs text-white leading-snug">${p.title}</h4>
                    </div>
                </div>
            `).join('');
        }

        // 40 टन न्यूनतम सीमा (MOQ) के साथ कैलकुलेटर
        function calculate() {
            const rate = parseFloat(document.getElementById('calcMaterial').value) || 0;
            const tons = parseFloat(document.getElementById('calcTons').value) || 0;
            const km = parseFloat(document.getElementById('calcKm').value) || 0;
            const warningEl = document.getElementById('moqWarning');
            const quoteBtn = document.getElementById('quoteBtn');

            // 40 टन न्यूनतम नियम
            if (tons < 40) {
                warningEl.classList.remove('hidden');
                document.getElementById('calcTotal').innerText = "अमान्य (न्यूनतम 40 टन)";
                document.getElementById('calcTotal').className = "text-sm font-bold text-red-400";
                quoteBtn.disabled = true;
                quoteBtn.classList.add('opacity-50', 'cursor-not-allowed');
                return null;
            } else {
                warningEl.classList.add('hidden');
                quoteBtn.disabled = false;
                quoteBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                document.getElementById('calcTotal').className = "text-2xl font-black text-amber-400";
            }

            const materialCost = rate * tons;
            const freightCost = km * 4.5 * tons; 
            const grandTotal = Math.round(materialCost + freightCost);

            document.getElementById('calcTotal').innerText = "₹" + grandTotal.toLocaleString('en-IN');
            return { rate, tons, km, materialCost, freightCost, grandTotal };
        }

        document.querySelectorAll('#calcMaterial, #calcTons, #calcTruck, #calcKm').forEach(el => {
            el.addEventListener('input', calculate);
        });

        // WhatsApp बल्क कोटेशन
        function sendInstantWhatsAppQuote() {
            const data = calculate();
            if (!data) {
                alert("हम 40 टन से कम का आर्डर स्वीकार नहीं करते हैं। कृपया 40 या उससे अधिक टन दर्ज करें।");
                return;
            }

            const matSelect = document.getElementById('calcMaterial');
            const matName = matSelect.options[matSelect.selectedIndex].getAttribute('data-name');
            const truck = document.getElementById('calcTruck').value;
            const name = document.getElementById('custName').value || 'माननीय ठेकेदार / बिल्डर';
            const phone = document.getElementById('custPhone').value || 'उपलब्ध नहीं';

            const myWhatsApp = "918926718000";
            const msg = `*AARV BUILDCON INFRASTRUCTURE (खनक)*%0A` +
                        `*थोक (बल्क) कोटेशन अनुरोध - न्यूनतम 40 MT*%0A%0A` +
                        `👤 *पार्टी / कंपनी:* ${name}%0A` +
                        `📞 *मोबाइल:* ${phone}%0A` +
                        `🪨 *सामग्री:* ${matName}%0A` +
                        `⚖️ *बल्क मात्रा:* ${data.tons} टन (स्वीकृत बल्क)%0A` +
                        `🚛 *वाहन प्रकार:* ${truck}%0A` +
                        `📍 *खनक खदान से दूरी:* ${data.km} KM लीड%0A` +
                        `💰 *अनुमानित कुल लागत:* ₹${data.grandTotal.toLocaleString('en-IN')}%0A%0A` +
                        `कृपया फाइनल बल्क रेट एवं 22 टायरी ट्रेलर रवानगी कन्फर्म करें।`;

            window.open(`https://wa.me/${myWhatsApp}?text=${msg}`, '_blank');
        }

        function openAdminModal() { document.getElementById('adminModal').classList.remove('hidden'); document.getElementById('adminModal').classList.add('flex'); }
        function closeAdminModal() { document.getElementById('adminModal').classList.add('hidden'); document.getElementById('adminModal').classList.remove('flex'); }
        function togglePaymentModal() { 
            const m = document.getElementById('paymentModal');
            m.classList.toggle('hidden'); m.classList.toggle('flex');
        }

        function verifyPin() {
            if(document.getElementById('adminPin').value === "1234") {
                document.getElementById('adminAuthScreen').classList.add('hidden');
                document.getElementById('adminDashboardScreen').classList.remove('hidden');
                loadAdminInputs();
            } else {
                alert("गलत पिन! केवल AARV ओनर ही लॉगिन कर सकते हैं।");
            }
        }

        function loadAdminInputs() {
            document.getElementById('adminRateInputs').innerHTML = materials.map((m, idx) => `
                <div class="bg-slate-800 p-2 rounded">
                    <label class="text-[10px] text-gray-400 block">${m.name}</label>
                    <input type="number" id="rateInput_${idx}" value="${m.rate}" class="w-full bg-slate-700 text-white text-xs p-1 rounded mt-0.5">
                </div>
            `).join('');
        }

        function saveNewRates() {
            materials.forEach((m, idx) => {
                const val = parseFloat(document.getElementById(`rateInput_${idx}`).value);
                if(val) m.rate = val;
            });
            renderRates();
            alert("खनक मंडी के सभी नए थोक भाव तुरंत अपडेट हो गए हैं!");
        }

        function publishNewPost() {
            const title = document.getElementById('postTitle').value;
            const img = document.getElementById('postImgUrl').value || "https://images.unsplash.com/photo-1578575437130-527eed3abbec?auto=format&fit=crop&w=600&q=80";
            if(!title) return alert("कृपया शीर्षक दर्ज करें!");
            
            marketingPosts.unshift({
                title: title,
                tag: "खनक बल्क",
                time: "अभी-अभी",
                img: img
            });
            renderFeed();
            closeAdminModal();
            alert("आपकी फोटो मार्केटिंग वॉल पर लाइव हो गई है!");
        }

        renderRates();
        renderFeed();
    </script>
</body>
</html>